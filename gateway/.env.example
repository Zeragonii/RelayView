# Generate a private random token: python -c "import secrets; print(secrets.token_urlsafe(48))"
RELAYVIEW_API_TOKEN=REPLACE_WITH_40_PLUS_CHARACTER_RANDOM_TOKEN

# Existing MQTT broker (same broker Frigate connects to).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=relayview
MQTT_PASSWORD=CHANGE_ME
MQTT_TLS=false
MQTT_TOPIC_PREFIX=frigate

# Exact Frigate camera IDs allowed to move. Do not use wildcards.
FRIGATE_PTZ_CAMERAS=front_garden,driveway
PTZ_STOP_SECONDS=0.9
